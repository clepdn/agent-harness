{
  "name": "@nano/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm --prefix ../.. run build:packages && npm run build --workspace @nano/web",
    "prestart": "npm --prefix ../.. run build:packages && npm run build --workspace @nano/web",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "@nano/plugins": "*",
    "@nano/protocol": "*",
    "@nano/config": "*",
    "@nano/control-api": "*",
    "@nano/plugin-control-discovery": "*",
    "@nano/plugin-control-http": "*",
    "@nano/plugin-control-operations": "*",
    "@nano/plugin-control-persistence": "*",
    "@nano/plugin-control-static-ui": "*",
    "@nano/plugin-control-supervisor": "*",
    "@nano/plugin-control-auth": "*",
    "fastify": "^5.8.4"
  }
}
