{
  "name": "@nano/tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "nano-tui": "src/index.ts"
  },
  "scripts": {
    "prestart": "npm --prefix ../.. run build:packages",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@nano/plugins": "*",
    "@nano/protocol": "*",
    "@nano/chat-client": "*",
    "@nano/plugin-tui-executor": "*",
    "@nano/plugin-tui-rpc-chat": "*"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
