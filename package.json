{
  "name": "nano",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/plugins/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start --workspace @nano/server --",
    "start:server": "npm run start --workspace @nano/server --",
    "start:worker": "npm run start --workspace @nano/runtime --",
    "start:client": "npm run start --workspace @nano/tool-client --",
    "dev": "npm run dev --workspace @nano/server",
    "dev:worker": "npm run dev --workspace @nano/runtime",
    "dev:client": "npm run dev --workspace @nano/tool-client",
    "pretest": "npm run build:packages",
    "test": "npm run test --workspaces --if-present && node --import tsx --test tests/plugin-boundary.test.ts",
    "prechat": "npm run build:nano-protocol && npm run build:chat-client",
    "chat": "tsx scripts/chat.ts",
    "prechat:local": "npm run build:nano-protocol && npm run build:chat-client",
    "chat:local": "tsx scripts/chat.ts",
    "dev:web": "npm run dev --workspace @nano/web",
    "build:web": "npm run build --workspace @nano/web",
    "preview:web": "npm run preview --workspace @nano/web",
    "build:harness": "npm run build --workspace @nano/harness-protocol && npm run build --workspace @nano/harness-core && npm run build --workspace @nano/harness-server && npm run build --workspace @nano/harness-client-node",
    "build:nano-protocol": "npm run build --workspace @nano/protocol",
    "build:chat-client": "npm run build --workspace @nano/chat-client",
    "build:packages": "npm run build:plugins && npm run build:harness && npm run build:nano-config && npm run build:nano-protocol && npm run build:chat-client",
    "build": "npm run build:packages && npm run build:web",
    "pretypecheck": "npm run build:packages",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "postinstall": "node packages/harness-client-node/postinstall.mjs",
    "build:plugins": "npm run build --workspace @nano/plugins",
    "build:nano-config": "npm run build --workspace @nano/config"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@nano/chat-client": "*",
    "@nano/plugins": "*",
    "@nano/protocol": "*",
    "openai": "^6.33.0",
    "@anthropic-ai/sdk": "^0.100.1",
    "xxhashjs": "^0.2.2",
    "diff": "^8.0.2"
  },
  "devDependencies": {
    "@nano/runtime-api": "*",
    "@nano/plugin-context-strategies": "*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "@types/xxhashjs": "^0.2.4"
  },
  "overrides": {
    "discord.js": {
      "undici": "6.27.0"
    },
    "@discordjs/rest": {
      "undici": "6.27.0"
    }
  }
}
