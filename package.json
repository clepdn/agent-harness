{
  "name": "niri",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "tsx src/index.ts --config config.toml --secrets secrets.toml.env",
    "dev": "tsx watch src/index.ts --config config.toml --secrets secrets.toml.env",
    "test": "CORAL_CONFIG=test-config.toml node --import tsx --test src/**/*.test.ts",
    "chat": "tsx scripts/chat.ts",
    "dev:web": "npm run dev --workspace @niri/web",
    "build:web": "npm run build --workspace @niri/web",
    "preview:web": "npm run preview --workspace @niri/web"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@niri/chat-client": "*",
    "@earendil-works/pi-ai": "file:./pi/packages/ai",
    "better-sqlite3": "^12.8.0",
    "discord.js": "^14.25.1",
    "fastify": "^5.8.4",
    "node-pty": "^1.1.0",
    "openai": "^6.33.0",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
