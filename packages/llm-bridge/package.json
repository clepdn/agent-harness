{
  "name": "@niri/llm-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "npm run build:admin",
    "build:admin": "vite build --config vite.config.ts",
    "prestart": "npm run build:admin",
    "start": "tsx src/index.ts",
    "predev": "npm run build:admin",
    "dev": "tsx watch src/index.ts",
    "test": "npm run build:admin && node --import tsx --test 'src/**/*.test.ts' 'src/**/*.test.tsx'",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.80.7",
    "@fastify/static": "^9.1.3",
    "fastify": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^7.1.9"
  }
}
