# Example secrets file. Copy to secrets.toml.env and fill in.
# This file is .gitignored; never commit real keys.
#
# Launch with:
#   nano --config /path/to/config.toml --secrets /path/to/secrets.toml.env
#
# Values here are merged on top of config.toml, so secret sections shadow
# their public counterparts.

[model]
api_key = ""

[fallback]
api_key = ""

[summary]
api_key = ""

[embeddings]
api_key = ""

[discord]
bot_token = ""
